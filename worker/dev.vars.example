# Local development vars for the auth Worker.
#
# Copy this file to `worker/.dev.vars` and fill in real values.
# `wrangler dev` (and `wrangler dev --local`) automatically reads .dev.vars
# and exposes them as the matching `env.X` strings — no need to also
# `wrangler secret put` them while developing locally.
#
# For production deploy, use `wrangler secret put <NAME>` instead, since
# .dev.vars is intentionally git-ignored.

GITHUB_APP_ID="12345"
GITHUB_APP_CLIENT_ID="Iv1.replace-me"
GITHUB_APP_CLIENT_SECRET="replace-me"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n... full PEM, BEGIN/END lines included ...\n-----END RSA PRIVATE KEY-----\n"
