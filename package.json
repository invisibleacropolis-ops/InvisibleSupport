{
  "name": "invisiblesupport",
  "version": "1.0.0",
  "description": "Invisible Support Portal - Agent-optimized modular architecture",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npx playwright test",
    "test:update": "npx playwright test --update-snapshots",
    "test:e2e": "npx playwright test tests/e2e",
    "serve": "npx http-server . -p 8080 -c-1",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:test": "npm --prefix worker test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invisibleacropolis-ops/InvisibleSupport.git"
  },
