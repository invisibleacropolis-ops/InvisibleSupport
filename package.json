  },
  "homepage": "https://github.com/invisibleacropolis-ops/InvisibleSupport#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
